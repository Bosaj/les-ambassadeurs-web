# ============================================================================
#  AABV — les-ambassadeurs-web — Environment variable template
#  Copy this file to `.env` and fill in real values. Do NOT commit `.env`.
# ============================================================================

# ----------------------------------------------------------------------------
#  CLIENT-SIDE  (VITE_*  ->  bundled into the browser build = PUBLIC)
#  Only publishable / anon keys belong here. Never put a secret behind VITE_.
# ----------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# ----------------------------------------------------------------------------
#  SERVER-SIDE SECRETS  (Netlify functions only — NOT exposed to the browser)
#  Must NOT be prefixed VITE_. Leaking any of these bypasses app security.
# ----------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_ENVIRONMENT=SANDBOX

# ----------------------------------------------------------------------------
#  TOOLING / CI TOKENS  (local dev + deploy only — the app never reads these)
#  Account-level tokens. Keep out of the bundle and out of git.
# ----------------------------------------------------------------------------
SUPABASE_ACCESS_TOKEN=sbp_your_supabase_access_token
NETLIFY_PERSONAL_ACCESS_TOKEN=nfp_your_netlify_token
GITHUB_PERSONAL_ACCESS_TOKEN=github_pat_your_github_token
